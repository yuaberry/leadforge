# ============================================================
# LEADFORGE — Variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione .env.local.
# ============================================================

# ---------- Supabase (obrigatório para auth/banco) ----------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (workers/services). NUNCA expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Connection string do Postgres (Project Settings → Database → URI)
# Use o pooler em modo transaction para serverless.
DATABASE_URL=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Chave AES-256-GCM para cifrar tokens de integrações (openssl rand -base64 32)
APP_ENCRYPTION_KEY=
# Segredo para geração de tokens de link rastreado (/go/[token])
LINK_TOKEN_SECRET=

# ---------- IA (server-only) ----------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
AI_MODEL=

# ---------- Fontes de dados ----------
# Google Maps Platform → Places API (New)
GOOGLE_PLACES_API_KEY=

# ---------- E-mail (outreach) ----------
# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
EMAIL_FROM="LeadForge <noreply@seudominio.com>"

# ---------- WhatsApp Business Cloud API ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ---------- Checkouts digitais (Kiwify / Kirvano) ----------
KIWIFY_WEBHOOK_SECRET=
KIRVANO_WEBHOOK_SECRET=

# ---------- Fila (opcional — dev usa fallback in-process) ----------
# redis://localhost:6379
REDIS_URL=

# Cron de campanhas (POST /api/cron/process-campaigns) — gere um segredo forte
CRON_SECRET=

# ---------- Stripe (billing — Phase 9) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
