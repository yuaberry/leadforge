{
  "name": "leadforge-desktop",
  "version": "1.1.0",
  "description": "LeadForge Desktop — Find. Qualify. Personalize. Convert.",
  "main": "main.js",
  "author": {
    "name": "Yua Devs",
    "email": "devs@yua.dev"
  },
  "homepage": "https://github.com/yuaberry/leadforge",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "prepare:server": "node scripts/prepare-server.js",
    "build:linux": "npm run prepare:server && electron-builder --linux --x64",
    "build:win": "npm run prepare:server && electron-builder --win --x64",
    "build:mac": "npm run prepare:server && electron-builder --mac --x64",
    "build:all": "npm run prepare:server && electron-builder --linux --win --mac"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.yuadevs.leadforge",
    "productName": "LeadForge",
    "directories": {
      "output": "build",
      "buildResources": "icons"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "icons/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "app/server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "icon": "icons/icon.png",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Business",
      "description": "LeadForge — Plataforma de inteligência comercial e conquista financeira digital",
      "icon": "icons/icon.png",
      "desktop": {
        "entry": {
          "Name": "LeadForge",
          "Comment": "Plataforma de inteligência comercial e conquista financeira digital",
          "Categories": "Office;Business;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2",
        "libgbm1",
        "libxshmfence1"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "icons/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LeadForge",
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "category": "public.app-category.business",
      "icon": "icons/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSHumanReadableCopyright": "© 2026 Yua Devs"
      }
    },
    "dmg": {
      "title": "LeadForge v${version}",
      "icon": "icons/icon.icns",
      "contents": [
        { "x": 130, "y": 220, "type": "file" },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
